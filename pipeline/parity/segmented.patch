+def _rss_any_rank(X: np.ndarray, y: np.ndarray) -> float:
+    """Residual sum of squares of the least-squares fit, whatever the rank of
+    X -- what R gets from lm.wfit, which fits a rank-deficient design on the
+    columns it can estimate rather than failing."""
+    coef, _, _, _ = np.linalg.lstsq(X, y, rcond=None)
+    resid = y - X @ coef
+    return float(resid @ resid)
+
